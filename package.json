{
  "name": "crm-prospeccao",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/server/prospeccao/tests/*.test.ts\"",
    "receita:carregar": "node --env-file-if-exists=.env --import tsx src/server/prospeccao/carregar-receita.ts --db dados/receita.duckdb",
    "receita:lista": "node --env-file-if-exists=.env --import tsx src/server/prospeccao/gerar-lista.ts --db dados/receita.duckdb",
    "receita:google": "node --env-file-if-exists=.env --import tsx src/server/prospeccao/verificar-google.ts --db dados/receita.duckdb",
    "receita:atualizar": "node --env-file-if-exists=.env --import tsx src/server/prospeccao/baixar-receita.ts --db dados/receita.duckdb --dados dados"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "2.4.6",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "yazl": "2.5.1"
  }
}
